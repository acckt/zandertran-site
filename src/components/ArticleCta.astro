---
export interface Props {
  eyebrow?: string;
  title?: string;
  text?: string;
  url?: string;
  button?: string;
}
const { eyebrow, title, text, url, button } = Astro.props;
---
<div class="article-cta">
  <div class="article-cta-eyebrow">{eyebrow}</div>
  <h3>{title}</h3>
  <p>{text}</p>
  <a href={url} class="btn-primary" target="_blank" rel="noopener">
    {button}
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
      <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </a>
</div>
